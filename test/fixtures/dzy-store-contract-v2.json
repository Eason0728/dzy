{
  "version": 2,
  "doc": "營運系統 ↔ 管理系統 共用契約唯一正本（docs/approver/spec.md §10–§13）。兩個 repo 各放一份、逐字相同，兩邊測試都讀它。",
  "transport": {
    "url": "營運系統 .env DZY_PLATFORM_URL（mini 內部 http://127.0.0.1:8799/platform/api）",
    "method": "POST，Content-Type text/plain，body 為 JSON 字串",
    "envelope_ok": {
      "ok": true,
      "data": {}
    },
    "envelope_err": {
      "ok": false,
      "code": "<代碼>",
      "error": "<中文訊息>"
    },
    "http": "成功與業務錯誤一律 HTTP 200；HTTP 非 200、逾時、連線失敗＝unreachable"
  },
  "errors": {
    "unauthorized": "svc_key 錯或未設",
    "ticket_invalid": "券格式錯、過期、用過、aud 不符",
    "bad_aud": "aud 不支援",
    "no_emp": "帳號不是同仁也不是 admin",
    "bad_input": "sub／unit 格式錯",
    "busy": "暫時性（兌換搶不到鎖）：營運系統當 unreachable 處理，不重送 redeem"
  },
  "sub": {
    "staff": "^DZY\\d{3,}$（大寫）",
    "admin_without_emp": "^U:[A-Za-z0-9_-]{1,64}$",
    "example": [
      "DZY023",
      "U:u_admin01"
    ]
  },
  "requests": {
    "ssoTicket": {
      "action": "ssoTicket",
      "token": "<管理系統登入 token>",
      "payload": {
        "aud": "store"
      }
    },
    "svcStoreRedeem": {
      "action": "svcStoreRedeem",
      "payload": {
        "svc_key": "<STORE_SVC_KEY>",
        "ticket": "<64 位小寫十六進位>",
        "aud": "store"
      }
    },
    "svcStoreWho": {
      "action": "svcStoreWho",
      "payload": {
        "svc_key": "<STORE_SVC_KEY>",
        "sub": "DZY023"
      }
    },
    "svcStoreRoster": {
      "action": "svcStoreRoster",
      "payload": {
        "svc_key": "<STORE_SVC_KEY>",
        "unit": "mzt-gf"
      }
    }
  },
  "responses": {
    "ssoTicket": {
      "ok": true,
      "data": {
        "ticket": "3f9a0c7e1b2d4f6a8c0e2a4c6e8f0a1b3d5f7a9c1e3a5c7e9b1d3f5a7c9e1b3d",
        "expires_in": 60
      }
    },
    "ident_active": {
      "ok": true,
      "data": {
        "sub": "DZY023",
        "active": true,
        "emp_no": "DZY023",
        "name": "陳小明",
        "admin": false,
        "hr_head": false,
        "unit": "mzt-gf",
        "title": "sm",
        "epoch": "2026-03-01",
        "token_after": 0,
        "pilot_units": [
          "mala-gf"
        ],
        "units_managed": [
          "mzt-gf"
        ],
        "void_units": [
          "mzt-gf"
        ],
        "att": {
          "people": [
            {
              "clock": "mztgf",
              "emp_id": "MZTGF03",
